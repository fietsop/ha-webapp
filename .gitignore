# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (contain sensitive data)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include example tfvars
!terraform.tfvars.example

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore Mac files
.DS_Store

# Ignore IDE files
.idea/
*.swp
*.swo
*~
.vscode/

# SSH keys
*.pem
*.key

# Backup files
*.bak
*.backup
